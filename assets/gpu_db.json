  "sources": {
    "lhr_removed": {
      "claim": "NVIDIA 自 R515 驱动分支起移除 LHR 限制器；Windows 首个确认版本为 516.94，Linux 为 515.65.01。",
      "url": "https://docs.nvidia.com/datacenter/tesla/pdf/NVIDIA_Data_Center_GPU_Driver_Release_Notes_515_v2.0.pdf"
    },
    "lhr_v2_unlock": {
      "claim": "LHR v2 的软件解禁需要同时修改 VBIOS 与专用驱动（如 LHRv2Unlocker），因此「已解锁」等价于「正在使用非公开驱动」。",
      "url": "https://github.com/LiyuanLucasLiu/NvidiaRTX-LHRv2Unlocker"
    },
    "ethash_values": {
      "claim": "解锁后算力取自 LHRv2Unlocker 项目公开实测（3060 v2 49 / 3060Ti 61 / 3070 57 / 3070Ti 69 / 3080 100 / 3080Ti 115 MH/s）；默认值取同型号无解锁驱动下的公开矿工实测中位数。",
      "url": "https://github.com/LiyuanLucasLiu/NvidiaRTX-LHRv2Unlocker"
    }
  },
  "lhr_ids": {
    "note": "已知的 LHR 版本 PCI Device ID（同一核心，后缀不同）。仅作辅助证据，不作为唯一判据。",
    "ids": {
      "2206": "GA102 RTX 3080",
      "2208": "GA102 RTX 3080 Ti",
      "2501": "GA106 RTX 3060 (v1)",
      "2503": "GA106 RTX 3060",
      "2504": "GA106 RTX 3060 Lite Hash Rate",
      "2505": "GA106 RTX 3060 Lite Hash Rate",
      "2507": "GA104 RTX 3070 Lite Hash Rate",
      "2508": "GA104 RTX 3070 Ti Lite Hash Rate"
    }
  },
  "tflops_reference": {
    "note": "每个型号的解锁后算力不同，判定必须按型号匹配。区间来自：实测（3070 Ti）或按 SM×256×2×boost 推算（其余）。",
    "cases": {
      "fp16_fp32acc_4096": {
        "algo": "FP16 + FP32 累加 @4096^3"
      },
      "bf16_fp32acc_4096": {
        "algo": "BF16 + FP32 累加 @4096^3"
      },
      "fp16_fp32acc_8192": {
        "algo": "FP16 @8192^3"
      },
      "bf16_fp32acc_8192": {
        "algo": "BF16 @8192^3"
      },
      "fp32_ref_4096": {
        "algo": "FP32 (control)"
      }
    },
